{
  "plugins": [
    "react",
    "import"
  ],
  "rules": {
    "react/forbid-elements": [
      "warn",
      {
        "forbid": []
      }
    ],
    "no-restricted-imports": [
      "warn",
      {
        "patterns": [
          {
            "group": [
              "components/commerce/**",
              "components/content/**",
              "components/core/**",
              "components/forms/**",
              "components/global/**",
              "components/sections/**",
              "ui_kits/storefront/**"
            ],
            "message": "Import design-system components from 'index.js', not component internals."
          }
        ]
      }
    ],
    "no-restricted-syntax": [
      "warn",
      {
        "selector": "Literal[value=/#[0-9a-fA-F]{3,8}\\b/]",
        "message": "Raw hex color — use a design-system color token via var()."
      },
      {
        "selector": "Literal[value=/\\b\\d+px\\b/]",
        "message": "Raw px value — use a design-system spacing token via var()."
      },
      {
        "selector": "Literal[value=/font-family\\s*:\\s*(?!['\\\"]?(?:Causten|Poppins))/i]",
        "message": "Font not provided by the design system. Available: Causten, Poppins."
      },
      {
        "selector": "JSXOpeningElement[name.name='AccordionItem'] > JSXAttribute > JSXIdentifier[name!=/^(?:title|content|open|key|ref|className|style|children)$/]",
        "message": "<AccordionItem> doesn't accept that prop. Declared props: title, content, open."
      },
      {
        "selector": "JSXOpeningElement[name.name='AnnouncementMessage'] > JSXAttribute > JSXIdentifier[name!=/^(?:text|href|key|ref|className|style|children)$/]",
        "message": "<AnnouncementMessage> doesn't accept that prop. Declared props: text, href."
      },
      {
        "selector": "JSXOpeningElement[name.name='BackToTop'] > JSXAttribute > JSXIdentifier[name!=/^(?:threshold|label|inline|key|ref|className|style|children)$/]",
        "message": "<BackToTop> doesn't accept that prop. Declared props: threshold, label, inline."
