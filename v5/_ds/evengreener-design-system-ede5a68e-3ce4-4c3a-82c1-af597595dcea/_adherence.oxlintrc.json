        "selector": "JSXOpeningElement[name.name='Badge'] > JSXAttribute > JSXIdentifier[name!=/^(?:type|saving|children|key|ref|className|style|children)$/]",
        "message": "<Badge> doesn't accept that prop. Declared props: type, saving, children."
